{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "none",
      "referenceSpace": {
        "type": "local-floor",
        "fallbackOrder": [
          "local",
          "viewer"
        ]
      },
      "features": {
        "handTracking": true,
        "anchors": true,
        "planeDetection": true,
        "meshDetection": true,
        "hitTest": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 70,
      "near": 0.01,
      "far": 100,
      "camera": {
        "position": [
          0,
          1.3,
          0.4
        ],
        "lookAt": [
          0,
          1.0,
          -1.2
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": true,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "horizon",
        "preferredColorScheme": "dark"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "kitchen",
      "activation": "localhost"
    }
  }
}
